# ==============================================================================
# HOMIES STUDIO — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env.local for local development. Never commit real keys to Git!
# ==============================================================================

# --- SUPABASE (DATABASE, AUTH, STORAGE, REALTIME) ---
# Client-side public credentials (required in Vercel & local development)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only admin credentials (optional, NEVER prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# --- SITE CONFIGURATION ---
NEXT_PUBLIC_SITE_URL=https://homies-agency.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- RAZORPAY PAYMENT GATEWAY (OPTIONAL) ---
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- EMAIL SERVICE (OPTIONAL) ---
RESEND_API_KEY=
SUPPORT_EMAIL=info.homiesstudio@gmail.com
