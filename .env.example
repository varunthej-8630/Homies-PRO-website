# ==============================================================================
# HOMIES STUDIO — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env.local for local development. Never commit real keys to Git!
# ==============================================================================

# --- SUPABASE (POSTGRESQL, AUTH, STORAGE) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key

# --- RAZORPAY PAYMENT GATEWAY ---
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# --- EMAIL SERVICE (RESEND / SENDGRID) ---
RESEND_API_KEY=re_...
SUPPORT_EMAIL=support@homiesstudio.com

# --- APPLICATION SETTINGS ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
